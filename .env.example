# ==== ARUS environment ====
# Salin jadi .env, isi nilainya. JANGAN commit .env (sudah di .gitignore).

# Kunci API Sectors (wajib). Ambil dari halaman API di sectors.app (plan Insider).
# Dipakai oleh: fetch_sectors*.py (harga, IHSG, broker, asing) — sumber data inti ARUS.
SECTORS_API_KEY=

# Token bot Telegram (wajib untuk alert). Buat lewat @BotFather -> /newbot.
# Format: 1234567890:AAE...
ARUS_BOT_TOKEN=

# Chat ID tujuan alert (wajib). Chat ID pribadi/kamu, bukan username.
# Cara cari: kirim pesan ke bot kamu, buka https://api.telegram.org/bot<TOKEN>/getUpdates
ARUS_CHAT_ID=
